# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# CONTACT FORM EMAIL DELIVERY (Server-Side Only — Never Expose to Frontend)
# Configure EITHER SMTP (recommended for Yahoo / corporate mail / Gmail App Password)
# OR Resend API to deliver contact form submissions to leobiga@yahoo.com.
# ------------------------------------------------------------------------------

# Option A: SMTP Configuration (e.g., smtp.mail.yahoo.com or smtp.gmail.com)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Option B: Resend API Configuration (https://resend.com)
RESEND_API_KEY=""
RESEND_FROM="LBA Website <onboarding@resend.dev>"

# Designated Recipients
CONTACT_PRIMARY_RECIPIENT="leobiga@yahoo.com"
CONTACT_SECONDARY_RECIPIENT="lbagh@yahoo.com"
